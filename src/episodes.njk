---
layout: layouts/base.njk
title: Episodes
permalink: /episodes/index.html
---
<section class="all-episodes">
  <div class="archive-header">
    <div class="eyebrow" data-i18n="archive">ARCHIVE</div>
    <h2 data-i18n="allIssues">All issues</h2>
  </div>

  <div class="week-groups archive-groups">
    {% for group in collections.weekGroups %}
      <article class="week-group archive-group">
        <div class="week-header">
          <div class="week-label">{{ group.weekLabel }}</div>
          <time>{{ group.start | date("yyyy-LL-dd") }} — {{ group.end | date("yyyy-LL-dd") }}</time>
        </div>

        <div class="language-grid">
          <div class="language-column">
            <div class="language-tag chinese" data-i18n="chinese">中文</div>
            {% for ep in group.zh %}
              <a class="story-card" href="{{ ep.url | withBase }}">
                <span class="story-date">{{ ep.data.date | date("yyyy-LL-dd") }}</span>
                <strong>{{ ep.data.title }}</strong>
                <p>{{ ep.data.summary }}</p>
              </a>
            {% endfor %}
          </div>

          <div class="language-column">
            <div class="language-tag english" data-i18n="english">English</div>
            {% for ep in group.en %}
              <a class="story-card" href="{{ ep.url | withBase }}">
                <span class="story-date">{{ ep.data.date | date("yyyy-LL-dd") }}</span>
                <strong>{{ ep.data.title }}</strong>
                <p>{{ ep.data.summary }}</p>
              </a>
            {% endfor %}
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
</section>
