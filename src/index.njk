---
layout: layouts/base.njk
title: Home
permalink: /index.html
---
<section class="frontpage">
  <div class="masthead-block">
    <div class="eyebrow">EAL WEEKLY</div>
    <h1 data-i18n="heroTitle">AI, explained for everyone.</h1>
    <p class="editorial-summary" data-i18n="heroDescription">A bilingual weekly journal covering AI news, tools, and ideas in plain language.</p>
  </div>

  <div class="divider"></div>

  {% set currentGroup = collections.weekGroups[0] if collections.weekGroups and collections.weekGroups.length else null %}
  <div class="issue-panel">
    <div class="issue-header">
      <span data-i18n="thisWeek">THIS WEEK</span>
      {% if currentGroup %}
        <time>{{ currentGroup.start | date("yyyy-LL-dd") }} — {{ currentGroup.end | date("yyyy-LL-dd") }}</time>
      {% else %}
        <time>2026-08-24 — 2026-08-24</time>
      {% endif %}
    </div>

    {% if currentGroup %}
      <div class="this-week-list">
        {% for ep in currentGroup.zh %}
          <a class="this-week-item" href="{{ ep.url | withBase }}">
            <span class="issue-kicker" data-i18n="chinese">中文</span>
            <strong>{{ ep.data.title }}</strong>
            <p>{{ ep.data.summary }}</p>
          </a>
        {% endfor %}
        {% for ep in currentGroup.en %}
          <a class="this-week-item" href="{{ ep.url | withBase }}">
            <span class="issue-kicker" data-i18n="english">English</span>
            <strong>{{ ep.data.title }}</strong>
            <p>{{ ep.data.summary }}</p>
          </a>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <div class="divider"></div>

  <section class="featured-section">
    <div class="featured-topbar">
      <h2 data-i18n="featured">精选文章</h2>
      <a href="{{ baseUrl }}episodes/" data-i18n="viewAll">查看全部</a>
    </div>

    <div class="week-groups">
      {% for group in collections.weekGroups | slice(0, 4) %}
        <article class="week-group">
          <div class="week-header">
            <div class="week-label">{{ group.weekLabel }}</div>
            <time>{{ group.start | date("yyyy-LL-dd") }} — {{ group.end | date("yyyy-LL-dd") }}</time>
          </div>

          <div class="language-grid">
            <div class="language-column">
              <div class="language-tag chinese" data-i18n="chinese">中文</div>
              {% for ep in group.zh %}
                <a class="story-card" href="{{ ep.url | withBase }}">
                  <span class="story-date">{{ ep.data.date | date("yyyy-LL-dd") }}</span>
                  <strong>{{ ep.data.title }}</strong>
                  <p>{{ ep.data.summary }}</p>
                </a>
              {% endfor %}
            </div>

            <div class="language-column">
              <div class="language-tag english" data-i18n="english">English</div>
              {% for ep in group.en %}
                <a class="story-card" href="{{ ep.url | withBase }}">
                  <span class="story-date">{{ ep.data.date | date("yyyy-LL-dd") }}</span>
                  <strong>{{ ep.data.title }}</strong>
                  <p>{{ ep.data.summary }}</p>
                </a>
              {% endfor %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  </section>

  <div class="divider"></div>

  <section class="explore-section">
    <h2 data-i18n="explore">EXPLORE</h2>
    <div class="topic-grid">
      <span data-i18n="aiNews">AI News</span>
      <span data-i18n="aiExplained">AI Explained</span>
      <span data-i18n="tutorials">Tutorials</span>
      <span data-i18n="tools">Tools</span>
      <span data-i18n="research">Research</span>
      <span data-i18n="aiEducation">AI × Education</span>
    </div>
  </section>

  <div class="divider"></div>

  <section class="learn-section">
    <h2 data-i18n="learn">LEARN</h2>
    <ul>
      <li data-i18n="learnAgent">What is an AI Agent?</li>
      <li data-i18n="learnLlm">What is an LLM?</li>
      <li data-i18n="learnRag">How does RAG work?</li>
      <li data-i18n="learnOpenSource">What does "open source AI" actually mean?</li>
    </ul>
  </section>
</section>
