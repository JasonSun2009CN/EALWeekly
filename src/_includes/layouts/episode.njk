---
layout: layouts/base.njk
---
{% set translation = collections.episodes | translationFor(page) %}
<article class="episode-full">
  <header>
    <div class="article-meta-row">
      <span class="week-badge">{{ weekLabel }}</span>
      <time>{{ date | date("yyyy-LL-dd") }}</time>
      {% if tags %}<span class="tag">{{ tags | join(", ") }}</span>{% endif %}
    </div>
    <h1>{{ title }}</h1>
  </header>

  {% if translation %}
    <div class="translation-switcher">
      {% if language == "zh" %}
        <a href="{{ translation.url | withBase }}" class="lang-button" data-i18n="englishVersion">English Version</a>
      {% else %}
        <a href="{{ translation.url | withBase }}" class="lang-button" data-i18n="chineseVersion">中文版本</a>
      {% endif %}
    </div>
  {% endif %}

  <section class="episode-body">
    {{ content | safe }}
  </section>

  {% set related = collections.episodes | relatedEpisodes(page, 4) %}
  {% if related.length > 0 %}
    <aside class="related-episodes">
      <h2 data-i18n="relatedEpisodes">相关文章</h2>
      <div class="related-list">
        {% for item in related %}
          <a class="story-card" href="{{ item.url | withBase }}">
            <span class="story-date">{{ item.data.date | date("yyyy-LL-dd") }} · {{ item.data.weekLabel }}</span>
            <strong>{{ item.data.title }}</strong>
            <p>{{ item.data.summary }}</p>
          </a>
        {% endfor %}
      </div>
    </aside>
  {% endif %}
</article>
